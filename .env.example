# Local development uses an isolated persistent PGlite database by default.
APP_URL=http://localhost:3000
# Generate a random secret, e.g. openssl rand -base64 32. Used once for the first admin.
SETUP_TOKEN=replace-with-a-long-random-setup-token
# Production requires PostgreSQL; never deploy with a local filesystem database.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# Migration connection: use the direct/unpooled URL.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=verify-full
# LOCAL_DATABASE_PATH=.data/grifo
